@model SchoolPageViewModel
@{
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var pageUrl = $"{origin}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="@Model.Meta.Description">
  <title>@Model.Meta.Title</title>
  <!-- Open Graph / Social Sharing -->
  <meta property="og:title" content="@Model.Meta.OgTitle">
  <meta property="og:description" content="@Model.Meta.OgDescription">
  <meta property="og:type" content="website">
  <meta property="og:url" content="@pageUrl">
  <meta property="og:image" content="@origin/images/og-default.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <!-- Favicon (inline SVG — navy rounded square with gold "S") -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%231B2A4A'/%3E%3Ctext x='50' y='68' text-anchor='middle' font-family='Georgia,serif' font-weight='bold' font-size='60' fill='%23C9A84C'%3ES%3C/text%3E%3C/svg%3E">
  <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png">
  <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <div class="container header-inner">
      <a asp-controller="School" asp-action="Index" asp-route-site="@Model.Site.Slug" class="logo">
        <span class="logo-icon">&#x1F393;</span> <span>@Model.Site.Name</span>
      </a>
      <button class="hamburger" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <nav>
        <ul class="main-nav">
          <li><a asp-controller="School" asp-action="Index" asp-route-site="@Model.Site.Slug">Home</a></li>
          <li><a asp-controller="School" asp-action="About" asp-route-site="@Model.Site.Slug">About</a></li>
          <li><a asp-controller="School" asp-action="Academics" asp-route-site="@Model.Site.Slug">Academics</a></li>
          <li><a asp-controller="School" asp-action="Admissions" asp-route-site="@Model.Site.Slug">Admissions</a></li>
          <li><a asp-controller="School" asp-action="Staff" asp-route-site="@Model.Site.Slug">Staff</a></li>
          <li><a asp-controller="School" asp-action="Calendar" asp-route-site="@Model.Site.Slug">Calendar</a></li>
          <li><a asp-controller="School" asp-action="Contact" asp-route-site="@Model.Site.Slug">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  @RenderBody()

  <!-- ==================== FOOTER ==================== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h3>@Model.Site.Name</h3>
          <p>123 Education Lane<br>Your City, ST 12345</p>
          <p>Phone: (555) 123-4567<br>Email: info@@school.edu</p>
        </div>
        <div class="footer-col">
          <h3>Office Hours</h3>
          <ul class="hours-list">
            <li><span class="day">Mon – Fri</span> <span class="time">8:00 AM – 4:00 PM</span></li>
            <li><span class="day">Saturday</span> <span class="time">Closed</span></li>
            <li><span class="day">Sunday</span> <span class="time">Closed</span></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Quick Links</h3>
          <ul>
            <li><a asp-controller="School" asp-action="About" asp-route-site="@Model.Site.Slug">About Us</a></li>
            <li><a asp-controller="School" asp-action="Academics" asp-route-site="@Model.Site.Slug">Academics</a></li>
            <li><a asp-controller="School" asp-action="Admissions" asp-route-site="@Model.Site.Slug">Admissions</a></li>
            <li><a asp-controller="School" asp-action="Staff" asp-route-site="@Model.Site.Slug">Staff</a></li>
            <li><a asp-controller="School" asp-action="Calendar" asp-route-site="@Model.Site.Slug">Calendar</a></li>
            <li><a asp-controller="School" asp-action="Contact" asp-route-site="@Model.Site.Slug">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Follow Us</h3>
          <div class="social-links">
            <a href="#" aria-label="Facebook">FB</a>
            <a href="#" aria-label="Twitter">TW</a>
            <a href="#" aria-label="Instagram">IG</a>
            <a href="#" aria-label="YouTube">YT</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 @Model.Site.Name. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="~/js/main.js" defer></script>
</body>
</html>
