@model PortalViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Directory of schools in Zamfara State, Nigeria. Find a school by name or local government area.">
  <title>zamfara.org — School Directory</title>
  <meta property="og:title" content="zamfara.org — School Directory">
  <meta property="og:description" content="Directory of schools in Zamfara State, Nigeria.">
  <meta property="og:type" content="website">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%231B2A4A'/%3E%3Ctext x='50' y='68' text-anchor='middle' font-family='Georgia,serif' font-weight='bold' font-size='52' fill='%23C9A84C'%3EZ%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

  <!-- ==================== HEADER ==================== -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label="zamfara.org — School Directory">
        <span class="logo-icon">&#x1F30D;</span>
        <span class="logo-full">zamfara.org</span>
        <span class="logo-short" aria-hidden="true">zamfara.org</span>
      </a>
    </div>
  </header>

  <main>

    <!-- ==================== PORTAL HERO ==================== -->
    <section class="portal-hero">
      <div class="container">
        <h1>Find a School in Zamfara State</h1>
        <p>A directory of schools across Zamfara State, Nigeria — each with its own website.</p>
        <label class="visually-hidden" for="school-search">Search schools</label>
        <input type="search" id="school-search" placeholder="Search by school name or LGA…" autocomplete="off">
      </div>
    </section>

    <!-- ==================== SCHOOL DIRECTORY ==================== -->
    <section class="section">
      <div class="container">
        <div class="portal-grid" id="portal-grid">
          @foreach (var s in Model.Schools)
          {
            <article class="portal-card" data-search="@s.School.Name @s.School.ShortName @s.School.Lga @s.School.Location">
              <div class="portal-card-emoji">@s.School.LogoEmoji</div>
              <h3>@s.School.Name</h3>
              <p class="portal-loc">@s.School.Location</p>
              <p>LGA: @s.School.Lga</p>
              <p>Phone: @s.School.Phone</p>
              <a href="@s.Url" class="btn btn-primary">Visit School Site</a>
            </article>
          }
        </div>
        <p id="no-results" hidden>No schools match your search.</p>
      </div>
    </section>

  </main>

  <footer class="portal-footer">
    <div class="container">
      <p>&copy; @DateTime.Now.Year zamfara.org — School Directory for Zamfara State, Nigeria.</p>
    </div>
  </footer>

  <script src="~/js/portal.js" defer></script>
</body>
</html>
