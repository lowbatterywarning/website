@model HomeViewModel
@{
    var school = Model.School;
}

<main>


  <!-- ==================== HERO ==================== -->
  <section class="hero">
    <div class="container">
      <h1>Welcome to @school.Name</h1>
      <p>@school.Tagline</p>
      <a asp-action="Admissions" class="btn btn-gold">Apply Now</a>
      <a asp-action="Calendar" class="btn btn-outline-light">View School Calendar</a>
    </div>
  </section>

  <!-- ==================== ABOUT TEASER ==================== -->
  <section class="section">
    <div class="container">
      <div class="about-teaser">
        <div class="teaser-image">
          <img src="~/@school.CampusPhoto" alt="@school.Name campus" loading="lazy" width="1334" height="768">
        </div>
        <div class="teaser-text">
          <h2>About @school.Name</h2>
          <p>
            Founded in @school.Established, @school.Name is a prominent public secondary
            institution in Gusau, Zamfara State, Nigeria. The school focuses heavily
            on the STEM pipeline, preparing students for senior secondary
            certificates via bodies like WAEC and NECO.
          </p>
          <p>
            Recently, under the administration of Governor Dauda Lawal, the
            school underwent an extensive rehabilitation and renovation —
            modernized classrooms, student facilities, and staff quarters,
            plus a newly paved internal road network across the campus.
          </p>
          <a asp-action="About" class="btn btn-outline mt-2">Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== HIGHLIGHT CARDS ==================== -->
  <section class="section" style="background:#F4F5F7;">
    <div class="container">
      <h2 style="text-align:center;">Discover @school.Name</h2>
      <p style="text-align:center; max-width:600px; margin:0 auto 2.5rem;">Four pillars that define the @school.Name experience.</p>

      <div class="highlight-grid">
        <a asp-action="Academics" class="highlight-card">
          <span class="card-icon">&#x1F4DA;</span>
          <h3>Academics</h3>
          <p>Rigorous STEM-focused curriculum with science labs, personalized learning paths, and WAEC/NECO preparation.</p>
        </a>
        <a asp-action="About" class="highlight-card">
          <span class="card-icon">&#x1F3C6;</span>
          <h3>Achievement</h3>
          <p>Over 55 years of graduates who went on to become medical doctors, engineers, and scientists.</p>
        </a>
        <a asp-action="About" class="highlight-card">
          <span class="card-icon">&#x1F91D;</span>
          <h3>Community</h3>
          <p>A warm, inclusive culture built on respect, service, and partnership between families and faculty.</p>
        </a>
        <a asp-action="Admissions" class="highlight-card">
          <span class="card-icon">&#x1F4DD;</span>
          <h3>Admissions</h3>
          <p>Your journey starts here. Learn about our process, visit campus, and apply for the upcoming year.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== NEWS / ANNOUNCEMENTS ==================== -->
  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">News &amp; Announcements</h2>
      <p style="text-align:center; max-width:600px; margin:0 auto 2.5rem;">Stay connected with the latest happenings around campus.</p>

      <!-- Featured story: GSTTP training programme -->
      <a class="featured-news mb-4" asp-action="Gsttp">
        <div class="featured-news-img" role="img" aria-label="Global Standard Teacher Transformation Programme participants">
          <img src="~/images/news/gsttp-1.jpg" alt="Global Standard Teacher Transformation Programme participants at ZACAS, Gusau" loading="lazy">
        </div>
        <div class="featured-news-body">
          <p class="news-date">August 10, 2026 &mdash; Featured</p>
          <h3>Zamfara Commences 18-Day Global Standard Teacher Transformation Programme for 250 Education Personnel</h3>
          <p>Read the full story of the GSTTP capacity-building programme for teachers, evaluators, and administrators across Zamfara State &raquo;</p>
        </div>
      </a>

      <div class="news-grid">
        @foreach (var n in Model.News)
        {
          <article class="news-card">
            <!-- [IMAGE: @n.ImageLabel — <img src="..." alt="..." loading="lazy">] -->
            <div class="news-img" role="img" aria-label="@n.ImageLabel">[IMAGE: @n.ImageLabel]</div>
            <div class="news-body">
              <p class="news-date">@n.DateText</p>
              <h3>@n.Title</h3>
              <p>@n.Body</p>
            </div>
          </article>
        }
      </div>

      <p style="text-align:center; margin-top:2rem;">
        <a asp-action="News" class="btn btn-outline">View All News</a>
      </p>
    </div>
  </section>

  <!-- ==================== CTA BAND ==================== -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready to Join the @school.Name Family?</h2>
      <p>We'd love to meet you. Visit the school calendar or start your application today — we're here to help every step of the way.</p>
      <a asp-action="Admissions" class="btn btn-primary">Apply Now</a>
      <a asp-action="Calendar" class="btn btn-outline">View School Calendar</a>
    </div>
  </section>


</main>
