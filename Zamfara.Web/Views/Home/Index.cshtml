@model PageMeta

<main>


  <!-- ==================== HERO ==================== -->
  <section class="hero">
    <div class="container">
      <h1>Welcome to @School.Name</h1>
      <p>Where curious minds grow, character takes root, and every student is known, challenged, and supported.</p>
      <a asp-action="Admissions" class="btn btn-gold">Apply Now</a>
      <a asp-action="Contact" class="btn btn-outline-light">Schedule a Visit</a>
    </div>
  </section>

  <!-- ==================== ABOUT TEASER ==================== -->
  <section class="section">
    <div class="container">
      <div class="about-teaser">
        <div class="teaser-image">
          <img src="~/images/campus.jpg" alt="@School.Name campus" loading="lazy" width="1334" height="768">
        </div>
        <div class="teaser-text">
          <h2>About @School.Name</h2>
          <p>
            Founded in 1969, @School.Name is a prominent public secondary
            institution in Gusau, Zamfara State, Nigeria — now over 55 years
            old. The school focuses heavily on the STEM pipeline, preparing
            students for senior secondary certificates via bodies like WAEC
            and NECO.
          </p>
          <p>
            Recently, under the administration of Governor Dauda Lawal, the
            school underwent an extensive rehabilitation and renovation —
            modernized classrooms, student facilities, and staff quarters,
            plus a newly paved internal road network across the campus.
          </p>
          <a asp-action="About" class="btn btn-outline mt-2">Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== HIGHLIGHT CARDS ==================== -->
  <section class="section" style="background:#F4F5F7;">
    <div class="container">
      <h2 style="text-align:center;">Discover @School.Name</h2>
      <p style="text-align:center; max-width:600px; margin:0 auto 2.5rem;">Four pillars that define the @School.Name experience.</p>

      <div class="highlight-grid">
        <a asp-action="Academics" class="highlight-card">
          <span class="card-icon">&#x1F4DA;</span>
          <h3>Academics</h3>
          <p>Rigorous college-prep curriculum with AP courses, STEM, and personalized learning paths.</p>
        </a>
        <a asp-action="About" class="highlight-card">
          <span class="card-icon">&#x1F3C6;</span>
          <h3>Extracurriculars</h3>
          <p>Athletics, performing arts, robotics, debate, and 20+ clubs that spark passion outside the classroom.</p>
        </a>
        <a asp-action="About" class="highlight-card">
          <span class="card-icon">&#x1F91D;</span>
          <h3>Community</h3>
          <p>A warm, inclusive culture built on respect, service, and partnership between families and faculty.</p>
        </a>
        <a asp-action="Admissions" class="highlight-card">
          <span class="card-icon">&#x1F4DD;</span>
          <h3>Admissions</h3>
          <p>Your journey starts here. Learn about our process, visit campus, and apply for the upcoming year.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== NEWS / ANNOUNCEMENTS ==================== -->
  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">News &amp; Announcements</h2>
      <p style="text-align:center; max-width:600px; margin:0 auto 2.5rem;">Stay connected with the latest happenings around campus.</p>

      <div class="news-grid">
        <article class="news-card">
          <!-- [IMAGE: Students working together in a science lab — <img src="..." alt="..." loading="lazy">] -->
          <div class="news-img" role="img" aria-label="Students working together in a science lab">[IMAGE: Science lab]</div>
          <div class="news-body">
            <p class="news-date">July 28, 2026</p>
            <h3>New STEM Wing Grand Opening</h3>
            <p>Our state-of-the-art science and technology wing opens this fall, featuring wet labs, a makerspace, and a rooftop greenhouse.</p>
          </div>
        </article>

        <article class="news-card">
          <!-- [IMAGE: Students holding championship trophy — <img src="..." alt="..." loading="lazy">] -->
          <div class="news-img" role="img" aria-label="Students holding a championship trophy">[IMAGE: Championship trophy]</div>
          <div class="news-body">
            <p class="news-date">July 15, 2026</p>
            <h3>Debate Team Wins State Championship</h3>
            <p>Congratulations to our varsity debate squad for bringing home the state title for the third consecutive year.</p>
          </div>
        </article>

        <article class="news-card">
          <!-- [IMAGE: Families at an open house event — <img src="..." alt="..." loading="lazy">] -->
          <div class="news-img" role="img" aria-label="Families at an open house event on campus">[IMAGE: Open house event]</div>
          <div class="news-body">
            <p class="news-date">June 30, 2026</p>
            <h3>Fall Open House — November 15</h3>
            <p>Prospective families are invited to tour campus, meet teachers, and experience @School.Name firsthand. Registration is now open.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== CTA BAND ==================== -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready to Join the @School.Name Family?</h2>
      <p>We'd love to meet you. Schedule a campus tour or start your application today — we're here to help every step of the way.</p>
      <a asp-action="Admissions" class="btn btn-primary">Apply Now</a>
      <a asp-action="Contact" class="btn btn-outline">Schedule a Visit</a>
    </div>
  </section>


</main>
